# SmartRoute ERP — Environment Variables
# Copy file này thành .env và điền thông tin thực tế

# PostgreSQL — đổi user/password/dbname cho phù hợp
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartroute"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# Nominatim geocoding (OpenStreetMap, miễn phí)
# Không cần API key, nhưng rate limit 1 req/giây
NOMINATIM_USER_AGENT="SmartRoute-ERP/1.0"

# Optional: Google Maps API (nếu muốn geocoding nhanh hơn)
# GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
